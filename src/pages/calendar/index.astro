---
// /calendar was a duplicate of /book (same redirect logic). GitHub Pages can't
// do a server-side redirect on static hosting, so this is a plain meta-refresh
// instead of re-porting the duplicated React component.
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/book/" />
    <link rel="canonical" href="/book/" />
    <title>Redirecting to /book/</title>
  </head>
  <body>
    <p>Redirecting to <a href="/book/">/book/</a>&hellip;</p>
  </body>
</html>
